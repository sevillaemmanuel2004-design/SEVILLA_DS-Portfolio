,"end":{"line":5,"column":1}},"key":"F8L6lM0im8"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"2 fully connected layers","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xw39O2aar9"}],"key":"xhKcnkmIOo"},{"type":"text","value":", ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"k9pw1wksJJ"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"batch size 8","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"nFOTkLIRSt"}],"key":"Ob7VB0Kbhw"},{"type":"text","value":", the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mieel9wFud"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"SGD","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"idhGYwhq6y"}],"key":"QrYBgcmrUh"},{"type":"text","value":" optimizer, and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZW7oLPpIHY"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1000 epochs","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YzPx6prmRd"}],"key":"BaxOAawfmi"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bltG5N4geO"}],"key":"B5f3KbpAhZ"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The data is the same temperature / rainfall / humidity → apples / oranges dataset from the source notebook.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"dlKOxeiu9E"}],"key":"T6Offu06wD"}],"identifier":"f392ccee","label":"f392ccee","html_id":"f392ccee","key":"qI4gHsHkgy"},{"type":"block","kind":"notebook-code","data":{"id":"61e8276e"},"children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import TensorDataset, DataLoader\n\ntorch.manual_seed(42)\n\n# inputs: temperature, rainfall, humidity\ninputs = np.array([[73, 67, 43], [91, 88, 64], [87, 134, 58],\n                   [102, 43, 37], [69, 96, 70]] * 3, dtype=\"float32\")\n\n# targets: apples, oranges\ntargets = np.array([[56, 70], [81, 101], [119, 133],\n                    [22, 37], [103, 119]] * 3, dtype=\"float32\")","identifier":"61e8276e-code","enumerator":"1","html_id":"id-61e8276e-code","key":"eabMQ6Egy9"},{"type":"outputs","id":"zVXOZVW4TXFkKlZ0W9Nqg","children":[],"identifier":"61e8276e-outputs","html_id":"id-61e8276e-outputs","key":"iKfndZwItX"}],"identifier":"61e8276e","label":"61e8276e","html_id":"id-61e8276e","key":"kCH2pLVnUD"},{"type":"block","kind":"notebook-content","data":{"id":"6be88688"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Prepare the data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nINnZpSeW4"}],"identifier":"id-1-prepare-the-data","label":"1. Prepare the data","html_id":"id-1-prepare-the-data","implicit":true,"key":"CMvDKGPhTc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Both inputs and targets are standardized so SGD stays stable over 1000 epochs. The predictions are converted back to the original scale at the end.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"s7JX8fL7ZH"}],"key":"jYjiEJ0amE"}],"identifier":"6be88688","label":"6be88688","html_id":"id-6be88688","key":"Sv7cFcWwSH"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4f27b2a5","outputId":"f6c83656-a44d-4405-c9e6-4908921b049f"},"children":[{"type":"code","lang":"python","executable":true,"value":"x_mean, x_std = inputs.mean(axis=0), inputs.std(axis=0)\ny_mean, y_std = targets.mean(axis=0), targets.std(axis=0)\n\nX = torch.tensor((inputs - x_mean) / x_std)\nY = torch.tensor((targets - y_mean) / y_std)\n\ndataset = TensorDataset(X, Y)\nloader = DataLoader(dataset, batch_size=8, shuffle=True)\n\nprint(\"Samples   :\", len(dataset))\nprint(\"Batch size:\", loader.batch_size)","identifier":"4f27b2a5-code","enumerator":"2","html_id":"id-4f27b2a5-code","key":"gGmqhqOw3V"},{"type":"outputs","id":"sHhEluDeaokfXXXwaCmPn","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"Samples   : 15\nBatch size: 8\n"},"children":[],"identifier":"4f27b2a5-outputs-0","html_id":"id-4f27b2a5-outputs-0","key":"A2va9sNazN"}],"identifier":"4f27b2a5-outputs","html_id":"id-4f27b2a5-outputs","key":"BYhXJDQWty"}],"identifier":"4f27b2a5","label":"4f27b2a5","html_id":"id-4f27b2a5","key":"VCysRXgq9y"},{"type":"block","kind":"notebook-content","data":{"id":"e61ac362"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Model with two fully connected layers","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hSSXxOgNEV"}],"identifier":"id-2-model-with-two-fully-connected-layers","label":"2. Model with two fully connected layers","html_id":"id-2-model-with-two-fully-connected-layers","implicit":true,"key":"mkhxMDn9PA"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The model has two ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qCr2jNDPv5"},{"type":"inlineCode","value":"nn.Linear","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qGjJNrio4i"},{"type":"text","value":" layers. No activation is placed between them because this is a linear regression, so the whole model stays linear.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"C9kGoqhwZZ"}],"key":"ULsoplJcCY"}],"identifier":"e61ac362","label":"e61ac362","html_id":"e61ac362","key":"FVE8y6S2lw"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"cfaad6ab","outputId":"e2518f21-8dcd-4b36-b6fe-e115f16fd6ea"},"children":[{"type":"code","lang":"python","executable":true,"value":"model = nn.Sequential(\n    nn.Linear(3, 8),\n    nn.Linear(8, 2)\n)\nprint(model)","identifier":"cfaad6ab-code","enumerator":"3","html_id":"cfaad6ab-code","key":"uhFDR5YvVc"},{"type":"outputs","id":"m26rwjU0vhaIyFxUHzM4i","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"Sequential(\n  (0): Linear(in_features=3, out_features=8, bias=True)\n  (1): Linear(in_features=8, out_features=2, bias=True)\n)\n"},"children":[],"identifier":"cfaad6ab-outputs-0","html_id":"cfaad6ab-outputs-0","key":"Z5H4ZZbaFy"}],"identifier":"cfaad6ab-outputs","html_id":"cfaad6ab-outputs","key":"Ib61nZrnyh"}],"identifier":"cfaad6ab","label":"cfaad6ab","html_id":"cfaad6ab","key":"KlDjDIzh34"},{"type":"block","kind":"notebook-content","data":{"id":"5fee5e6c"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Loss function and optimizer","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WMhXjYSzR0"}],"identifier":"id-3-loss-function-and-optimizer","label":"3. Loss function and optimizer","html_id":"id-3-loss-function-and-optimizer","implicit":true,"key":"WOrV8pNwIT"}],"identifier":"5fee5e6c","label":"5fee5e6c","html_id":"id-5fee5e6c","key":"GKy2FlZaHJ"},{"type":"block","kind":"notebook-code","data":{"id":"44d53473"},"children":[{"type":"code","lang":"python","executable":true,"value":"criterion = nn.MSELoss()\noptimizer = torch.optim.SGD(model.parameters(), lr=0.01)","identifier":"44d53473-code","enumerator":"4","html_id":"id-44d53473-code","key":"AHaWC8d3sf"},{"type":"outputs","id":"Gzcvtfhl9HZ5bTBNJquga","children":[],"identifier":"44d53473-outputs","html_id":"id-44d53473-outputs","key":"JEqjHhYe0d"}],"identifier":"44d53473","label":"44d53473","html_id":"id-44d53473","key":"ozSmzg4ot6"},{"type":"block","kind":"notebook-content","data":{"id":"980b2b03"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Train for 1000 epochs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OU3JADUEjd"}],"identifier":"id-4-train-for-1000-epochs","label":"4. Train for 1000 epochs","html_id":"id-4-train-for-1000-epochs","implicit":true,"key":"MHdBAaXBUx"}],"identifier":"980b2b03","label":"980b2b03","html_id":"id-980b2b03","key":"E3pT5as4nW"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"36ba3453","outputId":"5d5db2b9-bec0-4164-8a30-9fa6866c619f"},"children":[{"type":"code","lang":"python","executable":true,"value":"epochs = 1000\n\nfor epoch in range(1, epochs + 1):\n    total_loss = 0\n    for xb, yb in loader:\n        loss = criterion(model(xb), yb)\n\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n\n        total_loss += loss.item() * len(xb)\n\n    if epoch % 100 == 0:\n        print(f\"Epoch {epoch:4d}/{epochs}  Loss: {total_loss / len(dataset):.6f}\")","identifier":"36ba3453-code","enumerator":"5","html_id":"id-36ba3453-code","key":"yc8GYsHYNZ"},{"type":"outputs","id":"cs2pFm9XosKxtQqQqdwW4","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"Epoch  100/1000  Loss: 0.002257\nEpoch  200/1000  Loss: 0.000599\nEpoch  300/1000  Loss: 0.000471\nEpoch  400/1000  Loss: 0.000435\nEpoch  500/1000  Loss: 0.000421\nEpoch  600/1000  Loss: 0.000413\nEpoch  700/1000  Loss: 0.000412\nEpoch  800/1000  Loss: 0.000411\nEpoch  900/1000  Loss: 0.000413\nEpoch 1000/1000  Loss: 0.000411\n"},"children":[],"identifier":"36ba3453-outputs-0","html_id":"id-36ba3453-outputs-0","key":"K3cu3ae23F"}],"identifier":"36ba3453-outputs","html_id":"id-36ba3453-outputs","key":"ylYbWJY6jh"}],"identifier":"36ba3453","label":"36ba3453","html_id":"id-36ba3453","key":"nHWr5B6OxZ"},{"type":"block","kind":"notebook-content","data":{"id":"321211c8"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Evaluate the model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SB84j3zuzO"}],"identifier":"id-5-evaluate-the-model","label":"5. Evaluate the model","html_id":"id-5-evaluate-the-model","implicit":true,"key":"X0FMwNPTud"}],"identifier":"321211c8","label":"321211c8","html_id":"id-321211c8","key":"CFUFzIWuyS"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"57cc5392","outputId":"97c0e67d-3779-4f4a-ff50-8d86a9477b43"},"children":[{"type":"code","lang":"python","executable":true,"value":"with torch.no_grad():\n    preds = model(X).numpy() * y_std + y_mean\n\nmse = np.mean((preds - targets) ** 2)\nprint(\"MSE (original scale):\", round(float(mse), 4))\nprint()\nfor i in range(5):\n    print(f\"Sample {i + 1}: predicted {np.round(preds[i], 2)}  actual {targets[i]}\")","identifier":"57cc5392-code","enumerator":"6","html_id":"id-57cc5392-code","key":"SA0lvFwN52"},{"type":"outputs","id":"o7hXOnPZ5fcGN-fk4JsNi","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"MSE (original scale): 0.4833\n\nSample 1: predicted [56.9  69.93]  actual [56. 70.]\nSample 2: predicted [ 82.36 100.92]  actual [ 81. 101.]\nSample 3: predicted [118.76 133.  ]  actual [119. 133.]\nSample 4: predicted [21.11 37.06]  actual [22. 37.]\nSample 5: predicted [101.86 119.09]  actual [103. 119.]\n"},"children":[],"identifier":"57cc5392-outputs-0","html_id":"id-57cc5392-outputs-0","key":"oXn0J8XRBQ"}],"identifier":"57cc5392-outputs","html_id":"id-57cc5392-outputs","key":"JiKTy7kwAj"}],"identifier":"57cc5392","label":"57cc5392","html_id":"id-57cc5392","key":"DlXqIogxTq"},{"type":"block","kind":"notebook-content","data":{"id":"f902a20b"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fRRUJmcFXN"}],"identifier":"conclusion","label":"Conclusion","html_id":"conclusion","implicit":true,"key":"xVJIWwufTH"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The model follows every requirement: MSE loss, two fully connected layers, batch size 8, SGD, and 1000 epochs. The last cell shows the final MSE and compares the predictions with the real values.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RDLljk7qwd"}],"key":"t24PbPknsT"}],"identifier":"f902a20b","label":"f902a20b","html_id":"f902a20b","key":"TRAyOZhe8S"}],"key":"dEJZgVvbia"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory Task 3 — Forward and Backward Propagation","url":"/sevilla-laboratory-task-3","group":"index"},"next":{"title":"Laboratory Task 5 — PyTorch Basics","url":"/sevilla-laboratory-task-5","group":"index"}}},"domain":"http://localhost:3000"}