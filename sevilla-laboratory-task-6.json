","implicit":true,"key":"OXOPVIYnUT"}],"identifier":"d62310fd","label":"d62310fd","html_id":"d62310fd","key":"zry530qG60"},{"type":"block","kind":"notebook-code","data":{"id":"88e007e1"},"children":[{"type":"code","lang":"python","executable":true,"value":"import torch\nimport torch.nn as nn","identifier":"88e007e1-code","enumerator":"1","html_id":"id-88e007e1-code","key":"eQE57Rgy6B"},{"type":"outputs","id":"Ic4JAfcDaFLbTNcIi_ReH","children":[],"identifier":"88e007e1-outputs","html_id":"id-88e007e1-outputs","key":"sbCw3OFBzb"}],"identifier":"88e007e1","label":"88e007e1","html_id":"id-88e007e1","key":"DVe4HwexSV"},{"type":"block","kind":"notebook-content","data":{"id":"4de96f0f"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Work out the feature-map sizes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GS0g111taX"}],"identifier":"id-2-work-out-the-feature-map-sizes","label":"2. Work out the feature-map sizes","html_id":"id-2-work-out-the-feature-map-sizes","implicit":true,"key":"hNib7k6i9h"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Output size = floor((Input + 2P − K) / S) + 1, where P is padding, K is kernel size, and S is stride.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cq5mVC2RYg"}],"key":"nueZ3p5y4C"}],"identifier":"4de96f0f","label":"4de96f0f","html_id":"id-4de96f0f","key":"pR3bhQtLJO"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"b024cd37","outputId":"6fd9889f-0910-4027-9de2-ad4fc531a209"},"children":[{"type":"code","lang":"python","executable":true,"value":"def out_size(size, k, s, p):\n    return (size + 2 * p - k) // s + 1\n\ns = 28\ns = out_size(s, 3, 1, 1); print(\"After Conv1   :\", s)\ns = out_size(s, 2, 1, 1); print(\"After MaxPool1:\", s)\ns = out_size(s, 3, 1, 1); print(\"After Conv2   :\", s)\ns = out_size(s, 3, 1, 1); print(\"After Conv3   :\", s)\ns = out_size(s, 3, 1, 1); print(\"After Conv4   :\", s)\ns = out_size(s, 2, 1, 0); print(\"After MaxPool2:\", s)\n\nflat = 256 * s * s\nprint(\"Flatten size  :\", flat)","identifier":"b024cd37-code","enumerator":"2","html_id":"b024cd37-code","key":"psnj7ADVwq"},{"type":"outputs","id":"yTYrK3Wtiy6h3i4q03oQQ","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"After Conv1   : 28\nAfter MaxPool1: 29\nAfter Conv2   : 29\nAfter Conv3   : 29\nAfter Conv4   : 29\nAfter MaxPool2: 28\nFlatten size  : 200704\n"},"children":[],"identifier":"b024cd37-outputs-0","html_id":"b024cd37-outputs-0","key":"X8OPxYTbt9"}],"identifier":"b024cd37-outputs","html_id":"b024cd37-outputs","key":"ndd6RUt7mQ"}],"identifier":"b024cd37","label":"b024cd37","html_id":"b024cd37","key":"eIAPc9ZRr9"},{"type":"block","kind":"notebook-content","data":{"id":"7787b3d7"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Build the CNN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wInQ5Qv9hk"}],"identifier":"id-3-build-the-cnn","label":"3. Build the CNN","html_id":"id-3-build-the-cnn","implicit":true,"key":"bUvpJz31UX"}],"identifier":"7787b3d7","label":"7787b3d7","html_id":"id-7787b3d7","key":"jPRIXuceXY"},{"type":"block","kind":"notebook-code","data":{"id":"6371eb2f"},"children":[{"type":"code","lang":"python","executable":true,"value":"class CNN(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.features = nn.Sequential(\n            nn.Conv2d(1, 32, 3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.MaxPool2d(2, stride=1, padding=1),\n\n            nn.Conv2d(32, 64, 3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(64, 128, 3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(128, 256, 3, stride=1, padding=1),\n            nn.ReLU(),\n\n            nn.MaxPool2d(2, stride=1, padding=0),\n            nn.Dropout(p=0.2),\n        )\n        self.classifier = nn.Sequential(\n            nn.Flatten(),\n            nn.Linear(256 * 28 * 28, 1000),\n            nn.ReLU(),\n            nn.Linear(1000, 500),\n            nn.ReLU(),\n            nn.Linear(500, 10),\n            nn.Softmax(dim=1),\n        )\n\n    def forward(self, x):\n        return self.classifier(self.features(x))","identifier":"6371eb2f-code","enumerator":"3","html_id":"id-6371eb2f-code","key":"LmGmSrG9He"},{"type":"outputs","id":"_bXTntWdLxcVTyo4rWKBD","children":[],"identifier":"6371eb2f-outputs","html_id":"id-6371eb2f-outputs","key":"Ues5Fj9eN1"}],"identifier":"6371eb2f","label":"6371eb2f","html_id":"id-6371eb2f","key":"aBQlPSSPhq"},{"type":"block","kind":"notebook-content","data":{"id":"8b3a0afa"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Create the model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WvMHs56yvX"}],"identifier":"id-4-create-the-model","label":"4. Create the model","html_id":"id-4-create-the-model","implicit":true,"key":"dTDbECeeGZ"}],"identifier":"8b3a0afa","label":"8b3a0afa","html_id":"id-8b3a0afa","key":"e2sHYDz633"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"a58075ae","outputId":"18a7ce73-c02e-4b4b-a61d-4b17ce760893"},"children":[{"type":"code","lang":"python","executable":true,"value":"model = CNN()\nprint(model)","identifier":"a58075ae-code","enumerator":"4","html_id":"a58075ae-code","key":"yURP5HhO1H"},{"type":"outputs","id":"UwP6Q1IEv-r-1B3xg3XEx","children":[{"type":"output","jupyter_data":{"output_type":"stream","name":"stdout","text":"CNN(\n  (features): Sequential(\n    (0): Conv2d(1, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (1): ReLU()\n    (2): MaxPool2d(kernel_size=2, stride=1, padding=1, dilation=1, ceil_mode=False)\n    (3): Conv2d(32, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (4): ReLU()\n    (5): Conv2d(64, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (6): ReLU()\n    (7): Conv2d(128, 256, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (8): ReLU()\n    (9): MaxPool2d(kernel_size=2, stride=1, padding=0, dilation=1, ceil_mode=False)\n    (10): Dropout(p=0.2, inplace=False)\n  )\n  (classifier): Sequential(\n    (0): Flatten(start_dim=1, end_dim=-1)\n    (1): Linear(in_features=200704, out_features=1000, bias=True)\n    (2): ReLU()\n    (3): Linear(in_features=1000, out_features=500, bias=True)\n    (4): ReLU()\n    (5): Linear(in_features=500, out_features=10, bias=True)\n    (6): Softmax(dim=1)\n  )\n)\n"},"children":[],"identifier":"a58075ae-outputs-0","html_id":"a58075ae-outputs-0","key":"p3e8ololxk"}],"identifier":"a58075ae-outputs","html_id":"a58075ae-outputs","key":"usF9s3JJw7"}],"identifier":"a58075ae","label":"a58075ae","html_id":"a58075ae","key":"Vu34ErWPQ1"},{"type":"block","kind":"notebook-content","data":{"id":"3596ab9b"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Test with a dummy batch","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ckpkrYnVRS"}],"identifier":"id-5-test-with-a-dummy-batch","label":"5. Test with a dummy batch","html_id":"id-5-test-with-a-dummy-batch","implicit":true,"key":"xT7OWqqrTA"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The diagram uses a batch of 32, so a random input of shape ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"imVR5JvBGq"},{"type":"inlineCode","value":"(32, 1, 28, 28)","position":{"start":{"line":3,"column":1},"end":{